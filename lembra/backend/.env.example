# Copie para .env e ajuste.   PowerShell:  Copy-Item .env.example .env
PORT=3000
# Segredo do JWT (mínimo 16 caracteres). Gere um aleatório em produção.
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
DB_PATH=./data/lembra.db

# Entendimento por IA (opcional). Sem chave, o app usa o interpretador local do aparelho.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Limite de interpretações por IA por usuário/dia (controle de custo)
LIMITE_IA_DIARIO=100

CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Convites de reunião (resposta por link, aviso por e-mail e push)
# ---------------------------------------------------------------------------
# Endereço PÚBLICO do backend, sem barra no fim. É o que vai nos links dos e-mails/WhatsApp.
# Em teste local o convidado só abre o link se estiver na mesma rede (ex.: http://192.168.0.10:3000).
PUBLIC_URL=http://localhost:3000
# Assina os links dos convites (mínimo 16 caracteres). Vazio = usa o JWT_SECRET.
CONVITE_SECRET=
# Máximo de participantes convidados por usuário a cada 24 h
LIMITE_CONVITES_DIARIO=100

# E-mail por SMTP (Brevo, Amazon SES, Resend, Mailgun, Gmail com senha de app...).
# Deixe SMTP_HOST vazio para NÃO enviar e-mail (os links continuam sendo gerados).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_DE=Lembra <nao-responda@seudominio.com>

# Push (Firebase). Use UM dos dois; o arquivo da chave NUNCA vai para o Git.
# Desenvolvimento: caminho do JSON da conta de serviço, fora do repositório.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Hospedagem: o mesmo JSON em base64 (PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("chave.json")))
FIREBASE_SERVICE_ACCOUNT_BASE64=
MAKE_WEBHOOK_URL=