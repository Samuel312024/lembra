# Copie para .env e ajuste.   PowerShell:  Copy-Item .env.example .env
PORT=3000
# Segredo do JWT (mínimo 16 caracteres). Gere um aleatório em produção.
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
DB_PATH=./data/lembra.db

# Entendimento por IA (opcional). Sem chave, o app usa o interpretador local do aparelho.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Limite de interpretações por IA por usuário/dia (controle de custo)
LIMITE_IA_DIARIO=100

CORS_ORIGIN=*
